{
  "name": "ai-trpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm gen:api && pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @ai-trpg/server dev",
    "dev:web": "pnpm gen:api && pnpm --filter @ai-trpg/web dev",
    "gen:openapi": "pnpm --filter @ai-trpg/server gen:openapi",
    "gen:api": "pnpm gen:openapi && pnpm --filter @ai-trpg/api-client gen",
    "build": "pnpm gen:api && pnpm --filter @ai-trpg/server build && pnpm --filter @ai-trpg/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm gen:api && pnpm --filter @ai-trpg/api-client typecheck && pnpm --filter @ai-trpg/server typecheck && pnpm --filter @ai-trpg/web typecheck",
    "lint": "biome check . && node scripts/check-ports.mjs && pnpm lint:md",
    "lint:fix": "biome check --write . && pnpm lint:md:fix",
    "format": "biome format --write . && pnpm lint:md:fix",
    "test": "pnpm --filter @ai-trpg/server test && pnpm --filter @ai-trpg/web test",
    "test:run": "pnpm --filter @ai-trpg/server test:run && pnpm --filter @ai-trpg/web test:run",
    "screenshot": "tsx scripts/screenshot.ts",
    "clean:dev": "tsx scripts/clean-dev.ts",
    "smoke:deepseek": "pnpm --filter @ai-trpg/server smoke:deepseek",
    "smoke:deepseek:full": "pnpm --filter @ai-trpg/server smoke:deepseek:full",
    "agent:game": "pnpm --filter @ai-trpg/server exec tsx scripts/agent-game.ts",
    "agent:api": "pnpm --filter @ai-trpg/server exec tsx scripts/agent-api.ts",
    "audit:prompts": "pnpm --filter @ai-trpg/server audit:prompts",
    "verify": "pnpm install && pnpm gen:api && pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "pipeline": "pnpm verify && pnpm dev",
    "check:ports": "node scripts/check-ports.mjs",
    "db:generate": "pnpm --filter @ai-trpg/server db:generate",
    "db:migrate": "pnpm --filter @ai-trpg/server db:migrate",
    "db:check": "pnpm --filter @ai-trpg/server db:check",
    "db:seed": "pnpm --filter @ai-trpg/server db:seed",
    "db:reset": "pnpm --filter @ai-trpg/server db:reset",
    "db:demo": "pnpm --filter @ai-trpg/server db:demo",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules/**\" \"#**/dist/**\" \"#.VSCodeCounter/**\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules/**\" \"#**/dist/**\" \"#.VSCodeCounter/**\" --fix",
    "rag": "pnpm --filter @ai-trpg/server rag",
    "rag:ingest": "pnpm --filter @ai-trpg/server rag:ingest",
    "rag:search": "pnpm --filter @ai-trpg/server rag:search",
    "rag:smoke": "pnpm --filter @ai-trpg/server rag:smoke",
    "rag:eval": "pnpm --filter @ai-trpg/server rag:eval"
  },
  "devDependencies": {
    "@ai-trpg/shared": "workspace:*",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
