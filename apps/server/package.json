{
  "name": "@ai-trpg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "smoke:deepseek": "tsx scripts/run-deepseek-smoke.ts",
    "smoke:deepseek:full": "tsx scripts/run-deepseek-smoke.ts --full",
    "agent:game": "tsx scripts/agent-game.ts",
    "agent:api": "tsx scripts/agent-api.ts",
    "audit:prompts": "tsx scripts/audit-prompts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:demo": "tsx scripts/db-demo.ts",
    "rag": "tsx scripts/rag.ts",
    "rag:ingest": "tsx scripts/rag.ts ingest",
    "rag:search": "tsx scripts/rag.ts search",
    "rag:smoke": "tsx scripts/rag-smoke.ts",
    "rag:eval": "tsx scripts/rag-eval.ts"
  },
  "dependencies": {
    "@ai-trpg/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@huggingface/transformers": "^4.3.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino": "^10.4.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
