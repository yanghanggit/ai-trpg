{
  "name": "@ai-trpg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "smoke:deepseek": "tsx scripts/run-deepseek-smoke.ts",
    "smoke:deepseek:full": "tsx scripts/run-deepseek-smoke.ts --full",
    "smoke:deepseek:dump": "tsx scripts/run-deepseek-smoke.ts --dump"
  },
  "dependencies": {
    "@ai-trpg/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
