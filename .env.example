# 仓库根目录唯一的本地环境变量文件：cp .env.example .env
# 优先级：进程环境变量 > 本文件 > packages/shared 中的默认值
# 修改本文件后必须重启 `pnpm dev`（Vite 只在启动时读取环境变量）

# ---- 服务端 ----
# 监听 0.0.0.0，局域网内其它设备才能访问；改成 127.0.0.1 则仅本机可访问
HOST=0.0.0.0
PORT=8787
# "*" 表示开发期允许任意来源（含局域网 IP）；生产环境请改成具体来源，多个用英文逗号分隔
CORS_ORIGINS=*
LOG_LEVEL=info

# ---- Web ----
# 留空时：客户端自动使用「当前页面主机名 + 服务端端口」，用 en0 IP 打开页面就走 IP。
# 需要固定时再填，例如 http://192.168.1.100:8787（来自 ifconfig en0）。
VITE_API_BASE_URL=http://192.168.1.100:8787
VITE_DEV_PORT=5373

# ---- LLM ----
DEEPSEEK_API_KEY=
# 图像生成基建（pnpm image）；未配置时仅图像命令不可用
REPLICATE_API_TOKEN=

# ---- 过程轨迹 ----
# 按局/天追加 JSONL 到 logs/trace/，供 agent 事后复读与跨局聚合；测试环境自动关闭。
# 生产部署不必带上这两项（未配置时非测试环境默认写入仓库根的 logs/trace）。
TRACE_ENABLED=true
# TRACE_DIR=/absolute/path/to/traces

# ---- RAG / Embedding ----
# Transformers.js 模型；首次运行下载到 apps/server/.cache/transformers/
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# 量化精度：fp32 / fp16 / q8 / q4
EMBEDDING_DTYPE=q8
# 可选：覆盖模型缓存目录
# EMBEDDING_CACHE_DIR=
# EMBEDDING_BATCH_SIZE=32

# ---- 数据库 ----
# 本机 PostgreSQL；测试库使用 ai_trpg_test
DATABASE_URL=postgresql://<user>@127.0.0.1:5432/ai_trpg_dev
TEST_DATABASE_URL=postgresql://<user>@127.0.0.1:5432/ai_trpg_test
DB_POOL_MAX=10

# ---- 名字泄漏审计 ----
# 1/true/yes/on 时，每个行动回合结束后只扫本轮新增的 actor 记忆，发现真名泄漏写 trace 警告，不阻断回合。
TRPG_AUDIT_NAMES=0
