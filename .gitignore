# 依赖与构建产物
node_modules
dist
.vite

# 环境变量（保留示例文件）
.env
.env.local
.env.*.local

# 契约生成物（pnpm gen:api 重新生成）
packages/api-client/openapi.json
packages/api-client/src/schema.d.ts

# 测试与覆盖率
coverage

# 截图输出（保留目录占位）
screenshots/*
!screenshots/.gitkeep

# 开发期世界快照（保留目录占位）
**/worlds/*
!**/worlds/.gitkeep

# LLM 调试落盘（保留目录占位）
**/logs/*
!**/logs/.gitkeep

# 运行时 system prompt 导出（保留目录占位）
**/prompts/*
!**/prompts/.gitkeep

# 开发期故事总结（保留目录占位）
**/stories/*
!**/stories/.gitkeep

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
.VSCodeCounter/

# Transformers.js 模型缓存
apps/server/.cache/
